# Chargement des packages
library(dplyr)
library(sf)
library(mapsf)
library(readr)
library(writexl)
# 1. Importer les données tabulaires
tablo_com <- read_csv("M2 Géoprisme/DPE Modele 1-20251105/tablo_com_v1.csv")
# 2. Importer le shapefile des communes
communes_shp <- st_read("M2 Géoprisme/DPE Modele 1-20251105/Metropole_Rouen_Communes.shp")
# 3. Harmoniser les types pour la jointure
tablo_com <- tablo_com %>%
mutate(Code = as.character(Code),
pct_dpe = as.numeric(pct_dpe))
communes_shp <- communes_shp %>%
mutate(INSEE_COM = as.character(INSEE_COM))
# 4. Jointure spatiale
communes_dpe <- left_join(communes_shp, tablo_com, by = c("INSEE_COM" = "Code"))
# 5. Filtrer les communes avec données valides
communes_dpe <- communes_dpe %>%
filter(!is.na(pct_dpe))
# 6. Carte choroplèthe
mf_choro(x = communes_dpe, var = "pct_dpe",
pal = "Blues", nbreaks = 5,
leg_title = "% DPE réalisés")
# 7. Ajouter un titre
mf_title("Pourcentage de logements avec DPE par commune")
# 6. Carte choroplèthe
mf_choro(x = communes_dpe, var = "pct_dpe",
pal = "Blues", nbreaks = 5,
leg_title = "% DPE réalisés")
# Carte choroplèthe
mf_choro(x = communes_dpe, var = "pct_log",
pal = "Blues", nbreaks = 5,
leg_title = "% DPE réalisés")
# Carte choroplèthe
mf_choro(x = communes_dpe, var = "pct_dpe",
pal = "Blues", nbreaks = 5,
leg_title = "% DPE réalisés")
# Ajouter les pourcentages en texte sur la carte
mf_label(x = communes_dpe, var = "pct_dpe",
col = "black", cex = 0.7,
overlap = FALSE)
# Ajouter un titre
mf_title("Pourcentage de logements avec DPE par commune")
# 6. Carte choroplèthe
mf_choro(x = communes_dpe, var = "pct_dpe",
pal = "Blues", nbreaks = 5,
leg_title = "% DPE réalisés")
