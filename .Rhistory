$sidebarBgColorCustom: #f5f5f5;
$textColorCustom: #1a1a1a;
$sidebarTextColorCustom: #333333;
$headlineColorCustom: #000000;
$headingColorCustom: #000000;
$bodyLinkColorCustom: #444444;
$navLinkColorCustom: #000000;
$sidebarLinkColorCustom: #000000;
$footerTextColorCustom: #888888;
$buttonTextColorCustom: #ffffff;
$buttonHoverTextColorCustom: #ffffff;
$buttonBgColorCustom: #000000;
$buttonHoverBgColorCustom: #333333;
$borderColorCustom: #dddddd;',
con = "assets/noir-et-blanc-hex.scss"
)
list.files("assets", pattern = "\\.scss$")
blogdown::build_site()
blogdown::serve_site()
blogdown::build_site()
blogdown::serve_site()
blogdown::serve_site()
cat(readLines(".gitignore"), sep = "\n")
& "D:\programmes\Git\bin\git.exe" status
writeLines(
'.Rproj.user
.Rhistory
.RData
.Rprofile
public/
resources/
.hugo_build.lock',
con = ".gitignore"
)
blogdown::serve_site()
